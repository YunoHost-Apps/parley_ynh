#!/bin/bash

#=================================================
# INSTALL PARLEY FROM A BINARY RELEASE
#=================================================
#
# The release archive is expected to contain the two binaries next to each
# other: `parleyd` (the server) and `parleyctl` (the admin client). Nothing is
# compiled here -- if the upstream release stops shipping binaries, the source
# has to be built somewhere else and this script only needs `url`/`sha256`
# changed in the manifest.

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# REFUSE A SUBPATH INSTALL
#=================================================
#
# Parley's web interface references its assets and its login form as absolute
# paths (/assets/..., /login, /theme, /site.webmanifest) and the binary has no
# base-path setting at all. Under a subpath the page itself would answer 200
# while every asset and the login POST went to the domain root, where YunoHost
# serves the portal: a broken-looking UI that is hard to diagnose.
#
# PARLEY_ENDPOINT with a path is not a fix -- it only affects the API and
# federation URLs, which is why instance.json looks right in that setup.

if [ "$path" != "/" ]; then
    ynh_die "Parley must be installed at the root of its own domain: its web interface uses absolute paths (/assets, /login, /theme) and has no base-path setting. Choose a dedicated (sub)domain and leave the path as '/'."
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

for binary in parleyd parleyctl; do
    if [[ ! -f "$install_dir/$binary" ]]; then
        ynh_die "The release archive does not contain '$binary'. Is the source URL pointing at a binary release?"
    fi
    chmod 755 "$install_dir/$binary"
done

#=================================================
# GENERATE THE ADMIN TOKEN
#=================================================
#
# parleyd has no users of its own on first start: accounts are created through
# the HTTP API, which needs either an admin token or an existing session. The
# token is what the package and, if it wants to, the operator use for that.

ynh_script_progression "Generating the instance admin token..."

admin_token=$(openssl rand -hex 32)
ynh_app_setting_set --key=admin_token --value="$admin_token"

#=================================================
# CONFIGURE THE INSTANCE
#=================================================

ynh_script_progression "Adding $app's configuration files..."

mkdir -p "$data_dir" /var/log/"$app"
chown "$app:$app" "$data_dir" /var/log/"$app"

# The public IRC port and the loopback one parleyd listens on. Both are settings
# rather than constants because 6697 is a popular number and the admin may need
# to move it: `yunohost app setting parley irc_port <port>` then upgrade.
irc_port=${irc_port:-6697}
irc_local_port=${irc_local_port:-6667}
ynh_app_setting_set --key=irc_port --value="$irc_port"
ynh_app_setting_set --key=irc_local_port --value="$irc_local_port"

ynh_config_add --template="parley.env" --destination="$install_dir/parley.env"
chmod 640 "$install_dir/parley.env"
chown "$app:$app" "$install_dir/parley.env"

#=================================================
# SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_systemd
ynh_config_add_nginx
ynh_config_add_logrotate

# IRC over TLS. The stream{} block has to live in /etc/nginx/modules-enabled/,
# because that directory is included at nginx's top level: a stream block inside
# conf.d/*.conf would land in the http{} context and be a syntax error. This is
# the same mechanism YunoHost uses for its own TLS-passthrough block, and a lab
# run confirmed regen-conf does not remove foreign files from there.
ynh_script_progression "Adding the IRC terminator..."

ynh_config_add --template="parley-irc.conf" --destination="/etc/nginx/modules-enabled/$app-irc.conf"
chmod 644 "/etc/nginx/modules-enabled/$app-irc.conf"

nginx -t
ynh_systemctl --service=nginx --action=reload

yunohost service add "$app" --description="Federated IRC chat server" --log="/var/log/$app/$app.log"

# The tile in the YunoHost portal: for an app outside the catalog there is no
# logo_hash to inherit, so the package supplies the icon and records it on its
# own permission. This is the app's own artwork, taken from upstream.
cp "$YNH_APP_BASEDIR/conf/logo.png" "$install_dir/logo.png"
chown "$app:$app" "$install_dir/logo.png"
yunohost user permission update "$app.main" --logo "$install_dir/logo.png" >/dev/null

#=================================================
# START THE SERVICE
#=================================================

ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

# parleyd answers /healthz on the HTTP listener once it is ready to serve.
ready=false
for _ in $(seq 1 30); do
    if curl --fail --silent --show-error "http://127.0.0.1:$port/healthz" >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 1
done

if [[ "$ready" != true ]]; then
    ynh_print_warn "parleyd did not answer /healthz within 30 seconds"
    journalctl --unit="$app" --no-pager --lines=30 >&2 || true
    ynh_die "The service did not start; see the log above"
fi

# nginx -t does not bind anything, so a busy port only shows up here. Say it out
# loud instead of leaving an instance whose advertised IRC line goes nowhere.
if ! ss -ltn 2>/dev/null | grep -q ":$irc_port "; then
    ynh_die "Nothing is listening on the IRC port $irc_port after the nginx reload: the port is probably taken by another service. Move this instance with 'yunohost app setting $app irc_port <free port>' and run the upgrade."
fi

#=================================================
# CREATE THE ADMIN ACCOUNT
#=================================================
#
# The nick is the YunoHost login so that a later SSO integration has one name
# to reason about. The password is asked for in the manifest: without an
# identity provider there is nothing else to log in with.

ynh_script_progression "Creating the administrator account..."

# Over loopback, not over the public URL: nginx and the YunoHost SSO sit in
# front of the app, and at this point neither the certificate nor the permission
# is guaranteed to be ready. The API parleyctl speaks to is the same listener.
if ! printf '%s\n' "$admin_password" | \
    PARLEY_ENDPOINT="http://127.0.0.1:$port" \
    PARLEY_TOKEN="$admin_token" \
    "$install_dir/parleyctl" accounts create "$admin" -password-stdin; then
    ynh_die "Could not create the account for '$admin'"
fi

#=================================================
# END OF INSTALL
#=================================================

ynh_script_progression "Installation of $app completed" --last
