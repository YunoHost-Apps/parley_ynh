#!/bin/bash

#=================================================
# INSTALL PARLEY FROM A BINARY RELEASE
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

for binary in parleyd parleyctl; do
    if [[ ! -f "$install_dir/$binary" ]]; then
        ynh_die "The release archive does not contain '$binary'. Is the source URL pointing at a binary release?"
    fi
    chmod 755 "$install_dir/$binary"
done

#=================================================
# GENERATE THE ADMIN TOKEN
#=================================================
ynh_script_progression "Generating the instance admin token..."

admin_token=$(openssl rand -hex 32)
ynh_app_setting_set --key=admin_token --value="$admin_token"

#=================================================
# CONFIGURE THE INSTANCE
#=================================================
ynh_script_progression "Adding $app's configuration files..."

mkdir -p "$data_dir" /var/log/"$app"
chown "$app:$app" "$data_dir" /var/log/"$app"

irc_port=${irc_port:-6697}
irc_local_port=${irc_local_port:-6667}

# A second instance on this machine cannot reuse 6697 or 6667.
if ss -ltn 2>/dev/null | grep -q ":$irc_port "; then
    requested_port=$irc_port
    for candidate in $(seq "$requested_port" $((requested_port + 20))); do
        if ! ss -ltn 2>/dev/null | grep -q ":$candidate "; then
            irc_port=$candidate
            break
        fi
    done
    if [ "$irc_port" = "$requested_port" ]; then
        ynh_die "No free IRC port between $requested_port and $((requested_port + 20)): another service is holding them. Free one and retry."
    fi
    ynh_print_warn "IRC port $requested_port is already in use on this machine, so this instance listens on $irc_port. Tell your users the right port; the web interface shows it."
fi

if ss -ltn 2>/dev/null | grep -q ":$irc_local_port "; then
    requested_local=$irc_local_port
    for candidate in $(seq "$requested_local" $((requested_local + 20))); do
        if ! ss -ltn 2>/dev/null | grep -q ":$candidate "; then
            irc_local_port=$candidate
            break
        fi
    done
    if [ "$irc_local_port" = "$requested_local" ]; then
        ynh_die "No free loopback port between $requested_local and $((requested_local + 20)) for parleyd to listen on."
    fi
fi

ynh_app_setting_set --key=irc_port --value="$irc_port"
ynh_app_setting_set --key=irc_local_port --value="$irc_local_port"

ynh_config_add --template="parley.env" --destination="$install_dir/parley.env"
chmod 640 "$install_dir/parley.env"
chown "$app:$app" "$install_dir/parley.env"

#=================================================
# SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_systemd
ynh_config_add_nginx
ynh_config_add_logrotate

# nginx accepts one stream{} block: the shared wrapper plus one server per instance.
ynh_script_progression "Adding the IRC terminator..."

install -d -m 755 /etc/nginx/stream.d
ynh_config_add --template="parley-irc.conf" --destination="/etc/nginx/stream.d/$app.conf"
chmod 644 "/etc/nginx/stream.d/$app.conf"

if [ ! -f /etc/nginx/modules-enabled/parley-stream.conf ]; then
    cp "$YNH_APP_BASEDIR/conf/parley-stream.conf" /etc/nginx/modules-enabled/parley-stream.conf
    chmod 644 /etc/nginx/modules-enabled/parley-stream.conf
fi

rm -f "/etc/nginx/modules-enabled/$app-irc.conf"

nginx -t
ynh_systemctl --service=nginx --action=reload

yunohost service add "$app" --description="Federated IRC chat server" --log="/var/log/$app/$app.log"

# Not in the catalog, so there is no logo_hash to inherit.
cp "$YNH_APP_BASEDIR/conf/logo.png" "$install_dir/logo.png"
chown "$app:$app" "$install_dir/logo.png"
yunohost user permission update "$app.main" --logo "$install_dir/logo.png" >/dev/null

#=================================================
# START THE SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

ready=false
for _ in $(seq 1 30); do
    if curl --fail --silent --show-error "http://127.0.0.1:$port/healthz" >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 1
done

if [[ "$ready" != true ]]; then
    ynh_print_warn "parleyd did not answer /healthz within 30 seconds"
    journalctl --unit="$app" --no-pager --lines=30 >&2 || true
    ynh_die "The service did not start; see the log above"
fi

# nginx -t does not bind, so a taken port only shows up here.
if ! ss -ltn 2>/dev/null | grep -q ":$irc_port "; then
    ynh_die "Nothing is listening on the IRC port $irc_port after the nginx reload: the port is probably taken by another service. Move this instance with 'yunohost app setting $app irc_port <free port>' and run the upgrade."
fi

#=================================================
# CREATE THE ADMIN ACCOUNT
#=================================================
ynh_script_progression "Creating the administrator account..."

# Over loopback: neither the certificate nor the SSO permission is ready yet.
if ! printf '%s\n' "$admin_password" | \
    PARLEY_ENDPOINT="http://127.0.0.1:$port" \
    PARLEY_TOKEN="$admin_token" \
    "$install_dir/parleyctl" accounts create "$admin" -password-stdin; then
    ynh_die "Could not create the account for '$admin'"
fi

#=================================================
# END OF INSTALL
#=================================================

ynh_script_progression "Installation of $app completed"
