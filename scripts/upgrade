#!/bin/bash

#=================================================
# UPGRADE PARLEY FROM A NEWER BINARY RELEASE
#=================================================
#
# parley.db is never touched here: the server migrates its own schema and
# settings on start, and an older binary refuses to open a newer database --
# which is the correct behaviour, so downgrades are not supported.

source _common.sh
source /usr/share/yunohost/helpers

# Settings introduced by a later package version must exist before the
# templates below are rendered.
admin_token=$(ynh_app_setting_get --key=admin_token)
if [ -z "$admin_token" ]; then
    ynh_script_progression "Generating the instance admin token..." --weight=1
    admin_token=$(openssl rand -hex 32)
    ynh_app_setting_set --key=admin_token --value="$admin_token"
fi

ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

ynh_script_progression "Upgrading source files..."

# --keep keeps the rendered environment file, which is regenerated below.
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="parley.env"

for binary in parleyd parleyctl; do
    if [[ ! -f "$install_dir/$binary" ]]; then
        ynh_die "The release archive does not contain '$binary'. Is the source URL pointing at a binary release?"
    fi
    chmod 755 "$install_dir/$binary"
done

ynh_script_progression "Updating $app's configuration files..."

mkdir -p "$data_dir" /var/log/"$app"
chown "$app:$app" "$data_dir" /var/log/"$app"

ynh_config_add --template="parley.env" --destination="$install_dir/parley.env"
chmod 640 "$install_dir/parley.env"
chown "$app:$app" "$install_dir/parley.env"

ynh_config_add_systemd
ynh_config_add_nginx
ynh_config_add_logrotate

# The terminator has to follow a domain or port change, and it carries the
# certificate path, so regenerate it on every upgrade. Same split as install: one
# shared `stream {}` wrapper, one bare server per instance.
irc_port=$(ynh_app_setting_get --key=irc_port)
irc_port=${irc_port:-6697}
install -d -m 755 /etc/nginx/stream.d
ynh_config_add --template="parley-irc.conf" --destination="/etc/nginx/stream.d/$app.conf"
chmod 644 "/etc/nginx/stream.d/$app.conf"
if [ ! -f /etc/nginx/modules-enabled/parley-stream.conf ]; then
    cp "$YNH_APP_BASEDIR/conf/parley-stream.conf" /etc/nginx/modules-enabled/parley-stream.conf
    chmod 644 /etc/nginx/modules-enabled/parley-stream.conf
fi
rm -f "/etc/nginx/modules-enabled/$app-irc.conf"

yunohost service add "$app" --description="Federated IRC chat server" --log="/var/log/$app/$app.log"

cp "$YNH_APP_BASEDIR/conf/logo.png" "$install_dir/logo.png"
chown "$app:$app" "$install_dir/logo.png"
yunohost user permission update "$app.main" --logo "$install_dir/logo.png" >/dev/null

ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

nginx -t
ynh_systemctl --service=nginx --action=reload
if ! ss -ltn 2>/dev/null | grep -q ":$irc_port "; then
    ynh_print_warn "Nothing is listening on the IRC port $irc_port after the upgrade."
fi

ynh_script_progression "Upgrade of $app completed" --last
