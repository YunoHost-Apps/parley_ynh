#!/bin/bash

#=================================================
# REMOVE PARLEY
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# REMOVE SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Removing system configurations related to $app..."

ynh_config_remove_logrotate

if ynh_hide_warnings yunohost service status "$app" >/dev/null 2>&1; then
    yunohost service stop "$app" >/dev/null 2>&1 || true
    yunohost service remove "$app"
fi

ynh_config_remove_systemd

ynh_config_remove_nginx

# Nothing owns these files but this script: they are not part of any regen-conf
if [ -f "/etc/nginx/stream.d/$app.conf" ] || [ -f "/etc/nginx/modules-enabled/$app-irc.conf" ]; then
    rm -f "/etc/nginx/stream.d/$app.conf" "/etc/nginx/modules-enabled/$app-irc.conf"
    # instance is left on this machine.
    if ! ls /etc/nginx/stream.d/parley*.conf >/dev/null 2>&1; then
        rm -f /etc/nginx/modules-enabled/parley-stream.conf
    fi
    nginx -t && ynh_systemctl --service=nginx --action=reload
fi

ynh_script_progression "Removing $app's files..."

ynh_safe_rm "$install_dir"
ynh_safe_rm "$data_dir"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Removal of $app completed"
