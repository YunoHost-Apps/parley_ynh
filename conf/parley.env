# Environment for parleyd. Rendered by `ynh_config_add` with helpers 2.1;
# the file is 640 and owned by __APP__, because it carries the admin token.

# Identity of the instance: this is the name peers know it by.
PARLEY_DOMAIN=__DOMAIN__

# Public base URL. Peers and clients discover the rest from here.
PARLEY_ENDPOINT=https://__DOMAIN____PATH__

# Where parley.db (accounts, keys, history) lives.
PARLEY_DATA_DIR=__DATA_DIR__

# HTTP listener: loopback only, nginx terminates TLS in front of it.
PARLEY_HTTP_LISTEN=127.0.0.1:__PORT__

# X-Forwarded-For is only believed from listed addresses; without this the
# login rate limiter sees every client as 127.0.0.1.
PARLEY_HTTP_PROXIES=127.0.0.1

# IRC listener. Parley speaks plaintext IRC and expects TLS to be terminated in
# front of it: nginx does that on __IRC_PORT__ (see conf/parley-irc.conf, which
# lands in /etc/nginx/modules-enabled/), so the listener itself stays on
# loopback. Exposing 6667 as-is would hand out plaintext credentials while the
# web UI advertises a TLS connect line.
PARLEY_IRC_LISTEN=127.0.0.1:__IRC_LOCAL_PORT__
PARLEY_IRC_PORT=__IRC_PORT__

# The terminator above sends the PROXY header, and parleyd only honours it from
# addresses listed here. Both halves are required: with the header but without
# this list parleyd parses "PROXY TCP4 1.2.3.4 ..." as an IRC command and answers
# "451 * :You have not registered" before the real conversation.
PARLEY_IRC_PROXIES=127.0.0.1

# The YunoHost user who owns the instance.
PARLEY_ADMINS=__ADMIN__

# Bearer token for the admin API; generated at install time.
PARLEY_ADMIN_TOKEN=__ADMIN_TOKEN__

# SSO: ssowat authenticates the web interface and nginx forwards the YunoHost
# identity in these headers (proxy_params_with_auth). parleyd trusts them only
# from the addresses listed below, so a client cannot spoof the header from
# outside. The federation permissions are open to visitors, so those requests
# carry no header at all and authenticate with bearer tokens instead.
PARLEY_TRUSTED_PROXIES=127.0.0.1
PARLEY_TRUSTED_USER_HEADER=Ynh-User
PARLEY_TRUSTED_NAME_HEADER=Ynh-User-Fullname
PARLEY_TRUSTED_EMAIL_HEADER=Ynh-User-Email
